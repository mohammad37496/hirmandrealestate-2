# Runtime database (Neon/Vercel Postgres)
# Use the pooled URL for DATABASE_URL.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Optional direct/unpooled URL for migrations
DATABASE_URL_UNPOOLED=

# Required for /admin
HIRMAND_ADMIN_KEY=replace-with-a-long-random-secret

# Optional Vercel Blob storage for uploaded media
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=

# Optional SEO verification
VITE_GOOGLE_SITE_VERIFICATION=
VITE_SITE_URL=https://www.hirmandrealestate.ir
